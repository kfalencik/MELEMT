+++ b/LegendaryExplorer/LegendaryExplorerCore/GameFilesystem/MEDirectories.cs
@@ -563,5 +563,44 @@ namespace LegendaryExplorerCore.GameFilesystem
                 _ => throw new ArgumentOutOfRangeException(nameof(game), game, null),
             };
         }
+
+        // macOS helper: NTFS returns directory listings in (case-insensitive) alphabetical order, so
+        // Windows code silently depends on that order. APFS does not guarantee it. These return the
+        // same order .NET produces on NTFS: each directory's entries sorted, subdirectories visited
+        // breadth-first (FileSystemEnumerator queues subdirectories).
+
+        /// <summary>Directory.GetFiles with NTFS (Windows) ordering.</summary>
+        public static string[] GetFilesOrdered(string path, string searchPattern = "*", SearchOption searchOption = SearchOption.TopDirectoryOnly)
+        {
+            // Like Directory.GetFiles, a directory part in the pattern ("sub\*.pcc") is relative to path.
+            searchPattern = searchPattern.Replace('\\', Path.DirectorySeparatorChar);
+            var patternDirectory = Path.GetDirectoryName(searchPattern);
+            if (!string.IsNullOrEmpty(patternDirectory))
+            {
+                path = Path.Combine(path, patternDirectory);
+                searchPattern = Path.GetFileName(searchPattern);
+            }
+            if (searchOption == SearchOption.TopDirectoryOnly)
+            {
+                return Directory.GetFiles(path, searchPattern, SearchOption.TopDirectoryOnly).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
+            }
+            var result = new List<string>();
+            var queue = new Queue<string>();
+            queue.Enqueue(path);
+            while (queue.Count > 0)
+            {
+                var dir = queue.Dequeue();
+                result.AddRange(Directory.GetFiles(dir, searchPattern, SearchOption.TopDirectoryOnly).OrderBy(x => x, StringComparer.OrdinalIgnoreCase));
+                foreach (var sub in Directory.GetDirectories(dir).OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
+                {
+                    queue.Enqueue(sub);
+                }
+            }
+            return result.ToArray();
+        }
+
+        /// <summary>Directory.GetDirectories (top level) with NTFS (Windows) ordering.</summary>
+        public static string[] GetDirectoriesOrdered(string path, string searchPattern = "*") =>
+            Directory.GetDirectories(path, searchPattern, SearchOption.TopDirectoryOnly).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
     }
 }
